<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Match the versions the docfx host loads (docfx 2.80.1 on net10.0), so the plugin never asks for a newer assembly. -->
  <ItemGroup>
    <PackageReference Include="Docfx.Plugins" Version="2.80.1" />
    <PackageReference Include="System.Composition" Version="10.0.3" />
  </ItemGroup>

</Project>
