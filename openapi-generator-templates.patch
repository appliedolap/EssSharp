                 {{/supportsRetry}}
             };
 
-            return ExecClientAsync(getResponse, setOptions, request, options, configuration);
+            // Applied OLAP Modification
+            return ExecClientAsync(getResponse, setOptions, request, options, configuration, cancellationToken);
         }
 
